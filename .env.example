# Supabase Configuration for نادي منبر الشاب المبدع
# ضع هنا عنوان مشروع Supabase والمفتاح العام (Publishable Key / Anon Key)
VITE_SUPABASE_URL="https://geniskumuwdedhckkexn.supabase.co"

# أضف مفتاح anon العام هنا (Publishable / Anon Key)
# تحذير: لا تضع أبداً المفتاح السري (service_role) هنا أو في أي ملف يخص الواجهة الأمامية!
VITE_SUPABASE_ANON_KEY=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
